# reach optional API keys. Copy to ~/.reach/keys.env and chmod 600.
# The keyless commands (web, repo-wiki, yt, rss, repo) work without any of these.
EXA_API_KEY=          # reach search (get a free key at exa.ai)
JINA_API_KEY=         # raises reach web / search rate limits (optional; keyless works)
FIRECRAWL_API_KEY=    # reach crawl (firecrawl.dev)
APIFY_TOKEN=          # reach instagram / reddit / x-public / x-followers / linkedin (apify.com)
GROQ_API_KEY=         # reach transcribe fallback + /docs refresh cheap-model patching (console.groq.com)
PERPLEXITY_API_KEY=   # optional: reach psearch (perplexity.ai)

# Self-hosted endpoints (optional). Comma-separate several to try in order.
SEARXNG_URL=          # reach search fallback, e.g. http://127.0.0.1:8888
WHISPER_SERVER_URL=   # reach transcribe, a whisper.cpp server run with --convert, e.g. http://127.0.0.1:8093
DEEPSEEK_API_KEY=     # optional: /docs refresh --provider deepseek (platform.deepseek.com)
