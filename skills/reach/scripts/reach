#!/usr/bin/env bash
# reach | a thin, server-less internet-fetch router.
# Direct HTTP APIs + already-installed CLIs. No MCP servers, no daemons, no RAM footprint.
# Keys and endpoints (all optional) live in ~/.reach/keys.env, outside the repo:
#   EXA_API_KEY JINA_API_KEY FIRECRAWL_API_KEY APIFY_TOKEN GROQ_API_KEY PERPLEXITY_API_KEY
#   HARVESTAPI_KEY (LinkedIn) SCRAPECREATORS_API_KEY (IG/TikTok/FB) BRIGHTDATA_API_KEY (reviews)
#   SEARXNG_URL (self-hosted search)  WHISPER_SERVER_URL (self-hosted whisper.cpp server)
# Cookie-backed social still routes through `agent-reach`; public Actor routes run directly.
set -uo pipefail

KEYS="${REACH_KEYS:-$HOME/.reach/keys.env}"
# shellcheck source=/dev/null
[ -f "$KEYS" ] && { set -a; . "$KEYS"; set +a; }
UA="Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) reach/1.0"

_norm() { case "$1" in http://*|https://*) printf '%s' "$1" ;; *) printf 'https://%s' "$1" ;; esac; }

_jina() { # clean markdown of any URL (server-side JS render), keyless; key raises rate limit
  local url; url="$(_norm "$1")"
  local h=(-H "User-Agent: $UA")
  local out
  if [ -n "${JINA_API_KEY:-}" ]; then
    out="$(curl -s --max-time 45 "${h[@]}" -H "Authorization: Bearer $JINA_API_KEY" "https://r.jina.ai/$url")"
    # empty-balance key (402) blocks even free reads, so retry keyless
    case "$out" in *InsufficientBalanceError*) ;; *) printf '%s' "$out"; return ;; esac
  fi
  curl -s --max-time 45 "${h[@]}" "https://r.jina.ai/$url"
}

# --- cookie-social routing: reach is the single front door; these delegate to agent-reach ---
_ar_backend() { command -v agent-reach >/dev/null && agent-reach doctor --json 2>/dev/null | jq -r --arg p "$1" '.[$p].active_backend // "none"' || echo none; }
_need_social() { # $1=platform  $2=setup hint
  echo "reach: '$1' is cookie-gated deep social, routed to agent-reach (needs a burner Chrome profile + login)." >&2
  echo "       not configured yet. enable with: $2" >&2
  echo "       then check: agent-reach doctor --json | jq .$1" >&2
  exit 4
}
_apify_limit() {
  local limit="${REACH_APIFY_LIMIT:-20}"
  if ! [[ "$limit" =~ ^[0-9]+$ ]]; then
    echo "reach: REACH_APIFY_LIMIT must be an integer from 1 to 200" >&2
    return 2
  fi
  while [[ ${#limit} -gt 1 && "$limit" == 0* ]]; do
    limit="${limit#0}"
  done
  if (( ${#limit} > 3 )) || (( 10#$limit < 1 || 10#$limit > 200 )); then
    echo "reach: REACH_APIFY_LIMIT must be an integer from 1 to 200" >&2
    return 2
  fi
  limit=$((10#$limit))
  printf '%s' "$limit"
}
_apify_items() { # $1=actor id with ~ separator  $2=input JSON
  # Apify's sync endpoints run up to 300s server-side and return 408 past that.
  # Critically, a client that gives up FIRST does not abort the run: it keeps
  # going and keeps billing, and you lose the result you paid for. So every
  # --max-time here sits just ABOVE 300 to outlive the server's own limit.
  # Anything that genuinely needs longer must start async and poll instead.
  [ -n "${APIFY_TOKEN:-}" ] || { echo "reach: APIFY_TOKEN not set in $KEYS" >&2; return 3; }
  local tmp code; tmp="$(mktemp)"
  code="$(curl -sS --max-time 310 -o "$tmp" -w '%{http_code}' -X POST \
    "https://api.apify.com/v2/acts/$1/run-sync-get-dataset-items" \
    -H "Authorization: Bearer $APIFY_TOKEN" \
    -H "Content-Type: application/json" \
    -d "$2")"
  case "$code" in
    2*) cat "$tmp"; rm -f "$tmp" ;;
    *)  # 403 "Too many outstanding invoices" / 402 cap: name it, never look like "no results"
        echo "reach: apify HTTP ${code:-000} on $1: $(jq -r '.error.message // .error // empty' "$tmp" 2>/dev/null | head -c 160)" >&2
        rm -f "$tmp"; return 1 ;;
  esac
}

# --- direct social-data vendors (cheaper than Apify for the same data, no cookies) ---
# Every call is bounded (REACH_PAGES, 1..5 pages, default 1) and prints what it cost
# on stderr when the vendor says so. HarvestAPI returns `cost` (USD) per response;
# ScrapeCreators returns `credits_remaining`. Media URLs in the output are signed
# and expire (IG ~1-4 days), so do not store them as permanent links.
_pages() {
  local p="${REACH_PAGES:-1}"
  [[ "$p" =~ ^[1-5]$ ]] || { echo "reach: REACH_PAGES must be 1..5 (each page is billed)" >&2; return 2; }
  printf '%s' "$p"
}
_vendor_get() { # $1=vendor label $2=url $3=auth header, rest: name=value params. Body on stdout.
  # Returns 0 on HTTP 200 without a top-level error, 1 on a vendor/transport failure
  # (caller falls back), 5 when the vendor answered but the target itself is the
  # problem (private / not found): another vendor would fail the same way, and bill.
  local label="$1" url="$2" auth="$3"; shift 3
  local args=() kv; for kv in "$@"; do args+=(--data-urlencode "$kv"); done
  local tmp code; tmp="$(mktemp)"
  code="$(curl -sS -G --max-time 120 -o "$tmp" -w '%{http_code}' -H "$auth" "${args[@]}" "$url" 2>/dev/null)"
  local body; body="$(cat "$tmp")"; rm -f "$tmp"
  local msg; msg="$(printf '%s' "$body" | jq -r '(.error | if type=="object" then .error // .message else . end) // .message // empty' 2>/dev/null | head -c 160)"
  case "$code" in
    200) if printf '%s' "$body" | jq -e '(.error // null) == null' >/dev/null 2>&1; then printf '%s' "$body"; return 0; fi
         echo "reach: $label: ${msg:-error in a 200 body}" >&2; return 5 ;;
    401) echo "reach: $label: key rejected (401)" >&2; return 1 ;;
    402) echo "reach: $label: out of credits (402), check with: reach doctor" >&2; return 1 ;;
    403|404) echo "reach: $label: $code ${msg:-target unavailable}" >&2; return 5 ;;
    *)   echo "reach: $label: HTTP ${code:-000} ${msg}" >&2; return 1 ;;
  esac
}
_hv() { # HarvestAPI GET: $1=path, rest params. Prints the cost line on stderr.
  [ -n "${HARVESTAPI_KEY:-}" ] || { echo "reach: harvestapi: HARVESTAPI_KEY not set in $KEYS" >&2; return 1; }
  local p="$1"; shift
  local out rc; out="$(_vendor_get harvestapi "https://api.harvestapi.io$p" "X-API-Key: $HARVESTAPI_KEY" "$@")"; rc=$?
  [ $rc = 0 ] || return $rc
  printf '%s' "$out" | jq -r '"reach: harvestapi charged $\(.cost // "?") (\((.payments // []) | join(",")))"' >&2 2>/dev/null
  printf '%s' "$out"
}
_sc() { # ScrapeCreators GET: $1=path, rest params. Prints the credit line on stderr.
  [ -n "${SCRAPECREATORS_API_KEY:-}" ] || { echo "reach: scrapecreators: SCRAPECREATORS_API_KEY not set in $KEYS" >&2; return 1; }
  local p="$1"; shift
  local out rc; out="$(_vendor_get scrapecreators "https://api.scrapecreators.com$p" "x-api-key: $SCRAPECREATORS_API_KEY" "$@")"; rc=$?
  [ $rc = 0 ] || return $rc
  # A private / restricted profile comes back as success:true with HTTP 200-ish
  # fields errorStatus/message and 0 credits charged: surface it, do not fall back.
  if printf '%s' "$out" | jq -e '.errorStatus // (.success == false)' >/dev/null 2>&1; then
    echo "reach: scrapecreators: $(printf '%s' "$out" | jq -r '.message // .error // "target unavailable"')" >&2; return 5
  fi
  printf '%s' "$out" | jq -r '"reach: scrapecreators charged \(.credits_charged // 1) credit(s)" + (if .credits_remaining then ", \(.credits_remaining) left" else "" end)' >&2 2>/dev/null
  printf '%s' "$out"
}
_sc_total() { [ "${1:-0}" -gt 0 ] && echo "reach: served by scrapecreators, $1 page(s) = $1 credit(s) total" >&2; }

_offer_browser() { # the Chromium tier's browser is missing: ask on a terminal, hint otherwise
  if [ -t 0 ] && [ -t 2 ]; then
    printf 'reach: headless Chromium for the local web tier is not installed (~110 MB). Install now? [y/N] ' >&2
    read -r a; case "$a" in y|Y|yes) "$(dirname "$(readlink -f "$0")")/reach-render.py" install >&2 ;; *) return 1 ;; esac
  else
    echo "reach: local Chromium tier unavailable, run 'reach setup' once to install it" >&2; return 1
  fi
}

cmd="${1:-help}"; shift 2>/dev/null || true

case "$cmd" in
  web) # reach web <url>   (Jina -> local Chromium -> Firecrawl -> curl+extract)
    # Free tiers first; each is checked by HTTP status + content, not by grepping
    # error words. Exits 1 with the reason per backend when nothing worked, so an
    # empty page is never mistaken for success. REACH_FRESH=1 bypasses Jina's cache,
    # REACH_NO_BROWSER=1 skips the local Chromium tier.
    [ $# -ge 1 ] || { echo "usage: reach web <url>" >&2; exit 2; }
    url="$(_norm "$1")"; why=(); tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
    _ok() { # enough text, and not a bot-wall / challenge interstitial
      [ "$(wc -c <"$tmp")" -gt 120 ] || { why+=("$1: too little text"); return 1; }
      if head -c 1500 "$tmp" | grep -qiE '^Title: (Just a moment|Attention Required|Access denied|Security check)|Performing security verification|Target URL returned error 40[39]|verify you are (a )?human|cf-chl|captcha-delivery'; then
        why+=("$1: got a bot-wall / challenge page"); return 1
      fi
    }
    _emit() { cat "$tmp"; echo "reach: served by $1" >&2; exit 0; }

    render="$(dirname "$(readlink -f "$0")")/reach-render.py"
    # Reddit: Jina blocks anonymous reddit reads and old.reddit is login-walled, but
    # Chromium on www.reddit.com gets the post plus comments, so go there first.
    case "$url" in https://*reddit.com/*|https://redd.it/*) skip_jina=1; url="https://www.reddit.com/${url#*reddit.com/}" ;; *) skip_jina="" ;; esac

    # 1) Jina Reader: hosted JS render. An empty-balance key 402s even free reads, so retry keyless.
    jh=(-H "User-Agent: $UA"); [ "${REACH_FRESH:-}" = 1 ] && jh+=(-H "X-No-Cache: true")
    code=""; [ -n "$skip_jina" ] && code=skipped
    if [ -n "${JINA_API_KEY:-}" ]; then
      code="$(curl -s --max-time 45 -o "$tmp" -w '%{http_code}' "${jh[@]}" -H "Authorization: Bearer $JINA_API_KEY" "https://r.jina.ai/$url")"
      [ "$code" = 402 ] && why+=("jina key: out of credits (402), retried keyless")
    fi
    if [ -z "$code" ] || [ "$code" = 402 ]; then
      code="$(curl -s --max-time 45 -o "$tmp" -w '%{http_code}' "${jh[@]}" "https://r.jina.ai/$url")"
    fi
    # Jina can serve a stale (even wrong) cached snapshot; it flags those, so refetch live once
    if [ "$code" = 200 ] && [ "${REACH_FRESH:-}" != 1 ] && head -c 600 "$tmp" | grep -q 'cached snapshot of the original page'; then
      code="$(curl -s --max-time 45 -o "$tmp" -w '%{http_code}' "${jh[@]}" -H "X-No-Cache: true" "https://r.jina.ai/$url")"
    fi
    if [ "$code" = 200 ] && _ok jina; then _emit jina; fi
    [ "$code" = 200 ] || [ "$code" = skipped ] || why+=("jina: HTTP $code $(jq -r '.message // empty' "$tmp" 2>/dev/null | head -c 120)")

    # 2) Local headless Chromium + trafilatura: free, unlimited, renders JS.
    if [ "${REACH_NO_BROWSER:-}" != 1 ] && command -v uv >/dev/null; then
      err="$(timeout 90 "$render" render "$url" 2>&1 >"$tmp")"; rc=$?
      if [ $rc = 3 ] && _offer_browser; then
        err="$(timeout 90 "$render" render "$url" 2>&1 >"$tmp")"; rc=$?
      fi
      if [ $rc = 0 ]; then _ok chromium && _emit chromium
      else why+=("chromium: ${err:-timed out or empty}"); fi
    fi

    # 3) Firecrawl API (paid, 1 credit).
    if [ -n "${FIRECRAWL_API_KEY:-}" ]; then
      code="$(curl -s --max-time 60 -o "$tmp.fc" -w '%{http_code}' -X POST "https://api.firecrawl.dev/v2/scrape" \
        -H "Authorization: Bearer $FIRECRAWL_API_KEY" -H "Content-Type: application/json" \
        -d "$(jq -n --arg u "$url" '{url:$u, formats:["markdown"]}')")"
      jq -r '.data.markdown // empty' "$tmp.fc" 2>/dev/null >"$tmp"
      if [ "$code" = 200 ] && _ok firecrawl; then rm -f "$tmp.fc"; _emit firecrawl; fi
      case "$code" in
        200) ;; # _ok already logged why it was rejected
        402) why+=("firecrawl: out of credits (402)") ;;
        *)   why+=("firecrawl: HTTP $code $(jq -r '.error // empty' "$tmp.fc" 2>/dev/null | head -c 120)") ;;
      esac
      rm -f "$tmp.fc"
    fi

    # 4) Plain HTTP GET + local extraction (no JS).
    if html="$(curl -sSfL --max-time 25 -A "$UA" "$url" 2>&1)"; then
      if command -v uv >/dev/null && printf '%s' "$html" | "$render" extract "$url" >"$tmp" 2>/dev/null && _ok curl; then _emit curl+extract; fi
      if command -v pandoc >/dev/null && printf '%s' "$html" | pandoc -f html -t gfm-raw_html --wrap=none >"$tmp" 2>/dev/null && _ok curl; then _emit curl+pandoc; fi
      why+=("curl: fetched, but no readable content (JS-only page?)")
    else
      why+=("curl: ${html:-request failed}")
    fi

    echo "reach: all backends failed for $url" >&2
    printf '  - %s\n' "${why[@]}" >&2
    exit 1 ;;

  repo-wiki) # reach repo-wiki <org/repo>  (DeepWiki via Jina, keyless)
    [ $# -ge 1 ] || { echo "usage: reach repo-wiki <org/repo>" >&2; exit 2; }
    _jina "https://deepwiki.com/$1" ;;

  search) # reach search <query...>   (Exa -> SearXNG -> Jina search fallback)
    q="$*"
    [ -n "$q" ] || { echo "usage: reach search <query>" >&2; exit 2; }
    if [ -n "${EXA_API_KEY:-}" ]; then
      res="$(curl -s --max-time 30 -X POST "https://api.exa.ai/search" \
        -H "x-api-key: $EXA_API_KEY" -H "Content-Type: application/json" \
        -d "$(jq -n --arg q "$q" '{query:$q, numResults:8, type:"auto", contents:{text:{maxCharacters:500}}}')" \
        | jq -r 'if .results then .results[] | "- \(.title)\n  \(.url)\n  \((.text // "") | gsub("\\s+";" ") | .[0:220])" else empty end')"
      if [ -n "$res" ]; then printf '%s\n' "$res"; exit 0; fi
      echo "reach: exa returned nothing (run \`reach doctor\`: often out of credits), trying SearXNG" >&2
    fi
    # Self-hosted SearXNG (free, no key) when SEARXNG_URL is set. Comma-separate
    # several, e.g. a loopback address and a VPN address for the same instance.
    sxs="${SEARXNG_URL:-}"; for sx in ${sxs//,/ }; do
      res="$(curl -s --max-time 25 "$sx/search?q=$(printf '%s' "$q" | jq -sRr @uri)&format=json" 2>/dev/null \
        | jq -r '.results[:10][]? | "- \(.title)\n  \(.url)\n  \((.content // "") | gsub("\\s+";" ") | .[0:220])"' 2>/dev/null)"
      if [ -n "$res" ]; then printf '%s\n' "$res"; exit 0; fi
    done
    [ -n "${SEARXNG_URL:-}" ] && echo "reach: SearXNG unavailable, falling back to Jina search" >&2
    h=(-H "User-Agent: $UA" -H "Accept: text/plain" -H "X-Respond-With: no-content")
    [ -n "${JINA_API_KEY:-}" ] && h+=(-H "Authorization: Bearer $JINA_API_KEY")
    curl -s --max-time 30 "${h[@]}" "https://s.jina.ai/$(printf '%s' "$q" | jq -sRr @uri)" | sed -n '1,60p' ;;

  psearch) # reach psearch <query...>   (Perplexity Search API — indexed, cited results)
    q="$*"
    [ -n "$q" ] || { echo "usage: reach psearch <query>" >&2; exit 2; }
    [ -n "${PERPLEXITY_API_KEY:-}" ] || { echo "reach: no PERPLEXITY_API_KEY set" >&2; exit 2; }
    curl -s --max-time 30 -X POST "https://api.perplexity.ai/search" \
      -H "Authorization: Bearer $PERPLEXITY_API_KEY" -H "Content-Type: application/json" \
      -d "$(jq -n --arg q "$q" '{query:$q, max_results:8, search_context_size:"high"}')" \
      | jq -r 'if .results then .results[] | "- \(.title)\n  \(.url)\n  \((.snippet // .content // "") | gsub("\\s+";" ") | .[0:220])" else . end' ;;

  yt) # reach yt <url>   (metadata + auto transcript via yt-dlp, keyless)
    [ $# -ge 1 ] || { echo "usage: reach yt <url>" >&2; exit 2; }
    echo "## $(yt-dlp -q --no-warnings --print '%(title)s | %(channel)s | %(upload_date)s | %(duration_string)s | %(view_count)s views' "$1" 2>/dev/null)"
    tmp="$(mktemp -d)"
    yt-dlp -q --no-warnings --skip-download --write-auto-subs --write-subs \
           --sub-lang "en.*" --sub-format vtt -o "$tmp/%(id)s.%(ext)s" "$1" 2>/dev/null
    f="$(find "$tmp" -maxdepth 1 -type f -name '*.vtt' -print -quit)"
    if [ -n "$f" ]; then
      echo "### transcript"
      grep -vE '^(WEBVTT|Kind:|Language:|NOTE|[0-9:.]+ -->|^[[:space:]]*$)' "$f" \
        | sed -E 's/<[^>]+>//g; s/&nbsp;/ /g' | awk '!seen[$0]++'
    else echo "(no transcript available)"; fi
    rm -rf "$tmp" ;;

  rss) # reach rss <feed-url>
    [ $# -ge 1 ] || { echo "usage: reach rss <feed-url>" >&2; exit 2; }
    curl -s --max-time 25 -A "$UA" "$1" | python3 -c '
import sys, re, xml.etree.ElementTree as ET
raw = sys.stdin.read()
raw = re.sub(r"xmlns(:\w+)?=\"[^\"]*\"", "", raw)   # drop namespace decls
raw = re.sub(r"(</?)[A-Za-z][\w.-]*:", r"\1", raw)   # drop element prefixes (atom:, content:, dc:)
raw = re.sub(r"\s[A-Za-z][\w.-]*:([A-Za-z_][\w.-]*=)", r" \1", raw)  # drop attribute prefixes
try: root = ET.fromstring(raw)
except Exception as e: print("parse error:", e); sys.exit(0)
items = root.findall(".//item") or root.findall(".//entry")
for it in items[:15]:
    t = (it.findtext("title") or "").strip()
    l = it.findtext("link") or ""
    if not l:
        le = it.find("link"); l = le.get("href") if le is not None else ""
    d = (it.findtext("pubDate") or it.findtext("updated") or it.findtext("published") or "").strip()
    print(f"- {t}\n  {l}  {d}")
' ;;

  repo) # reach repo <org/repo>   (GitHub metadata + README via gh)
    [ $# -ge 1 ] || { echo "usage: reach repo <org/repo>" >&2; exit 2; }
    gh api "repos/$1" --jq '"\(.full_name) | ⭐\(.stargazers_count) | \(.language) | \(.description // "")\npushed \(.pushed_at) | license \(.license.spdx_id // "none") | \(.open_issues_count) open issues"' 2>/dev/null || echo "gh api failed for $1"
    echo "--- README (head) ---"
    gh api "repos/$1/readme" -H "Accept: application/vnd.github.raw" 2>/dev/null | sed -n '1,60p' ;;

  instagram|ig) # reach instagram <username|url> [limit]   (ScrapeCreators -> Apify, no cookies / no account risk)
    [ $# -ge 1 ] || { echo "usage: reach instagram <username|url> [limit]" >&2; exit 2; }
    case "$1" in http*) url="$1";; *) url="https://www.instagram.com/${1#@}/";; esac
    handle="${url#*instagram.com/}"; handle="${handle%%[/?]*}"
    lim="${2:-12}"; [[ "$lim" =~ ^[0-9]+$ ]] && [ "$lim" -ge 1 ] && [ "$lim" -le 60 ] || { echo "reach: limit must be 1..60" >&2; exit 2; }
    # 1) ScrapeCreators: 1 credit per 12 posts. Pages = ceil(limit/12), capped by REACH_PAGES.
    maxp="$(_pages)" || exit $?; want=$(( (lim + 11) / 12 )); [ "$want" -gt "$maxp" ] && want="$maxp"
    pd="$(mktemp -d)"; trap 'rm -rf "$pd"' EXIT
    cur=""; n=0; rc=0
    while [ "$n" -lt "$want" ]; do
      if [ -n "$cur" ]; then _sc /v2/instagram/user/posts "handle=$handle" "next_max_id=$cur" trim=true >"$pd/$n.json"; rc=$?
      else _sc /v2/instagram/user/posts "handle=$handle" trim=true >"$pd/$n.json"; rc=$?; fi
      [ $rc = 0 ] || { rm -f "$pd/$n.json"; break; }
      cur="$(jq -r 'if .more_available then .next_max_id // empty else empty end' "$pd/$n.json")"
      n=$((n + 1)); [ -n "$cur" ] || break
    done
    if [ "$n" -gt 0 ]; then
      _sc_total "$n"
      jq -rs --argjson n "$lim" '
        ((.[0].user // .[0].items[0].user // {}) | "## @\(.username // "?") | \(.full_name // "") | followers:\(.follower_count // "?") posts:\(.media_count // "?")"),
        ([.[].items // [] | .[]] | .[:$n][] | "- \({"1":"image","2":"video","8":"carousel"}[(.media_type // 0)|tostring] // "post") | \((.taken_at // 0) | todate) | hearts:\(.like_count // 0) comments:\(.comment_count // 0)\(if .play_count then " plays:\(.play_count)" else "" end)\n  https://www.instagram.com/p/\(.code)/\n  \((.caption.text // "") | gsub("\\s+";" ") | .[0:200])")' "$pd"/*.json
      exit 0
    fi
    [ $rc = 5 ] && exit 1   # private / unavailable: Apify would fail the same way, and bill
    # 2) Apify fallback (apify~instagram-scraper).
    [ -n "${APIFY_TOKEN:-}" ] || { echo "reach: APIFY_TOKEN not set in $KEYS (Apify fallback)" >&2; exit 3; }
    echo "reach: falling back to Apify (apify~instagram-scraper)" >&2
    curl -s --max-time 310 -X POST "https://api.apify.com/v2/acts/apify~instagram-scraper/run-sync-get-dataset-items" \
      -H "Authorization: Bearer $APIFY_TOKEN" \
      -H "Content-Type: application/json" \
      -d "$(jq -n --arg u "$url" --argjson n "$lim" '{directUrls:[$u], resultsType:"posts", resultsLimit:$n, addParentData:false}')" \
    | jq -r 'if type=="array" then .[] | "- \(.type // "post") | \(.timestamp // "") | hearts:\(.likesCount // 0) comments:\(.commentsCount // 0)\n  \(.url // "")\n  \((.caption // "") | gsub("\\s+";" ") | .[0:200])" else "apify error: \(.error.message // .)" end' ;;

  reddit) # reach reddit <query...>   or   reach reddit r/<sub> <query>   (Apify search: no app, no cookies, no account risk)
    [ $# -ge 1 ] || { echo "usage: reach reddit <query...>   |   reach reddit r/<sub> <query>" >&2; exit 2; }
    [ -n "${APIFY_TOKEN:-}" ] || { echo "reach: APIFY_TOKEN not set in $KEYS" >&2; exit 3; }
    comm=""; case "$1" in r/*) comm="${1#r/}"; shift ;; esac
    q="$*"; [ -n "$q" ] || q="$comm"
    input="$(jq -n --arg q "$q" --arg c "$comm" '{searches:[$q], searchPosts:true, searchComments:false, searchCommunities:false, sort:"relevance", maxItems:15, includeMediaLinks:true, skipComments:true} + (if $c != "" then {searchCommunityName:$c} else {} end)')"
    curl -s --max-time 310 -X POST "https://api.apify.com/v2/acts/trudax~reddit-scraper-lite/run-sync-get-dataset-items" \
      -H "Authorization: Bearer $APIFY_TOKEN" \
      -H "Content-Type: application/json" -d "$input" \
    | jq -r 'if type=="array" then ([.[] | select(.dataType=="post")] | if length==0 then "(no posts found)" else (.[] | "- [\(.communityName // "")] \(.title)\n  \(.url)  up:\(.upVotes // 0) comments:\(.numberOfComments // 0)") end) else "apify error: \(.error.message // .)" end' ;;

  x-public|x-apify|twitter-apify) # reach x-public <query> | reach x-public user <handle>
    # Public X data through an Apify Actor: no cookies, no account risk. The
    # Actor is configurable rather than hardcoded — Actors get deprecated,
    # repriced and replaced, and the route should outlive any one vendor.
    [ $# -ge 1 ] || { echo "usage: reach x-public <query>  |  reach x-public user <handle>" >&2; exit 2; }
    lim="$(_apify_limit)" || exit $?
    if [ "$1" = user ]; then
      [ $# -eq 2 ] || { echo "usage: reach x-public user <handle>" >&2; exit 2; }
      handle="${2#@}"
      input="$(jq -n --arg h "$handle" --argjson n "$lim" \
        '{mode:"profileTweets", twitterHandles:[$h], maxItems:$n, maxItemsPerTarget:$n, outputVariant:"rich", fieldStyle:"camelCase", outputPreset:"flat"}')"
    else
      q="$*"
      input="$(jq -n --arg q "$q" --argjson n "$lim" \
        '{mode:"search", searchTerms:[$q], maxItems:$n, maxItemsPerTarget:$n, outputVariant:"rich", fieldStyle:"camelCase", outputPreset:"flat", includeSearchTerms:true}')"
    fi
    _apify_items "${REACH_X_TWEET_ACTOR:-xquik~x-tweet-scraper}" "$input" \
      | jq -c 'if type=="array" then .[] else . end' ;;

  x-followers|twitter-followers) # reach x-followers <handle> [followers|following|verified_followers]
    [ $# -ge 1 ] && [ $# -le 2 ] || {
      echo "usage: reach x-followers <handle> [followers|following|verified_followers]" >&2
      exit 2
    }
    handle="${1#@}"
    relation="${2:-followers}"
    case "$relation" in
      followers|following|verified_followers) ;;
      *) echo "reach: relation must be followers, following, or verified_followers" >&2; exit 2 ;;
    esac
    lim="$(_apify_limit)" || exit $?
    input="$(jq -n --arg h "$handle" --arg r "$relation" --argjson n "$lim" \
      '{twitterHandles:[$h], relation:$r, maxItems:$n, maxItemsPerTarget:$n, outputMode:"compact", overlapMode:false, includeTargetMetadata:true}')"
    _apify_items "${REACH_X_FOLLOWER_ACTOR:-xquik~x-follower-scraper}" "$input" \
      | jq -c 'if type=="array" then .[] else . end' ;;

  doc) # reach doc <file.docx|pptx|xlsx|pdf|epub|odt|rtf|csv>   (anydoc, local, keyless)
    # The one gap in reach: everything else reads the public web, nothing read a
    # file already on disk. Client briefs and RFPs arrive as .docx and .pdf, and
    # an agent could not open them.
    #
    # Local on purpose. Firecrawl's hosted /parse does the same conversion, but
    # these are usually someone's contract — converting locally means it never
    # leaves the machine. anydoc is pure Rust, no ML, no service, median <5ms.
    [ $# -ge 1 ] || { echo "usage: reach doc <file>   (docx pptx xlsx odt rtf epub csv pdf)" >&2; exit 2; }
    [ -f "$1" ] || { echo "reach: no such file: $1" >&2; exit 1; }
    command -v uv >/dev/null || { echo "reach: needs uv (https://docs.astral.sh/uv/) for the anydoc wheel" >&2; exit 3; }
    uv run --quiet --with firecrawl-anydoc python -c '
import sys, anydoc
try:
    sys.stdout.write(anydoc.to_markdown(sys.argv[1]))
except Exception as exc:
    msg = str(exc)
    sys.stderr.write("reach: anydoc could not convert this file: %s\n" % msg)
    if "nsupported" in msg or "scan" in msg.lower():
        sys.stderr.write("       Scanned/image-only PDFs need OCR. Try Firecrawl:\n")
        sys.stderr.write("       curl -s https://api.firecrawl.dev/v2/parse -H \"Authorization: Bearer $FIRECRAWL_API_KEY\" -F file=@%s\n" % sys.argv[1])
    sys.exit(1)
' "$1" ;;

  transcribe) # reach transcribe <audio-url|file>   (self-hosted whisper.cpp, Groq fallback)
    [ $# -ge 1 ] || { echo "usage: reach transcribe <audio-url-or-file>" >&2; exit 2; }
    src="$1"; tmp="$(mktemp -d)"; f="$src"
    case "$src" in
      http*) yt-dlp -q --no-warnings -x --audio-format mp3 -o "$tmp/a.%(ext)s" "$src" 2>/dev/null || curl -s -L --max-time 180 -A "$UA" "$src" -o "$tmp/a.mp3"
             f="$(find "$tmp" -maxdepth 1 -type f -name 'a.*' -print -quit)" ;;
    esac
    [ -f "$f" ] || { echo "reach: could not obtain audio from $src" >&2; rm -rf "$tmp"; exit 1; }
    # Self-hosted first: a whisper.cpp server (started with --convert so it takes
    # any audio format) at WHISPER_SERVER_URL, comma-separated for several. No
    # key, no upload limit, no expiry. Groq is the fallback.
    wss="${WHISPER_SERVER_URL:-}"; for url in ${wss//,/ }; do
      url="${url%/}"
      curl -s -o /dev/null --max-time 3 "$url/" || continue
      if out="$(curl -sf --max-time 3600 "$url/inference" -F "file=@$f" -F response_format=text -F language=auto)" && [ -n "$out" ]; then
        printf '%s\n' "$out"; rm -rf "$tmp"; exit 0
      fi
      echo "reach: local whisper at $url failed, trying the next option" >&2
    done
    [ -n "${GROQ_API_KEY:-}" ] || { echo "reach: no reachable WHISPER_SERVER_URL and no GROQ_API_KEY in $KEYS (free at https://console.groq.com/keys)" >&2; rm -rf "$tmp"; exit 3; }
    curl -s --max-time 300 "https://api.groq.com/openai/v1/audio/transcriptions" \
      -H "Authorization: Bearer $GROQ_API_KEY" \
      -F "file=@$f" -F "model=whisper-large-v3-turbo" -F "response_format=text"
    rm -rf "$tmp" ;;

  x|twitter) # reach x <query>  |  reach x user <handle>   (routes to agent-reach; needs cookie backend)
    [ $# -ge 1 ] || { echo "usage: reach x <query>  |  reach x user <handle>" >&2; exit 2; }
    b="$(_ar_backend twitter)"; [ "$b" = none ] && _need_social twitter "agent-reach install --channels twitter"
    if [ "$1" = user ]; then shift; twitter-cli user "$1" 2>/dev/null || opencli twitter user "$1" -f yaml
    else twitter-cli search "$*" 2>/dev/null || opencli twitter search "$*" -f yaml; fi ;;

  linkedin) # reach linkedin <profile-url> | reach linkedin posts <profile-url>   (Apify Actor, no cookies)
    # Was routed to agent-reach's linkedin-scraper MCP, which has been unconfigured
    # (backend "off") and therefore silently dead. HarvestAPI's Actors need no cookie
    # and no account, so nothing here can get a LinkedIn account restricted.
    #
    # Input keys come from the Actor's own schema, not from guessing -- a wrong key
    # makes the run SUCCEED with an empty dataset instead of erroring:
    #   GET /v2/acts/<actor>/builds/default/openapi.json
    #
    # HarvestAPI's direct API (same company, same payload as its Apify Actors) is tried
    # first: $0.004 per profile/company lookup or per ~100-post page (measured
    # 2026-10-23), no Apify plan needed. Apify is the fallback.
    [ $# -ge 1 ] || { echo "usage: reach linkedin <profile-url> | reach linkedin posts <profile-url>" >&2; exit 2; }
    lim="$(_apify_limit)" || exit $?
    if [ "$1" = posts ]; then
      [ $# -eq 2 ] || { echo "usage: reach linkedin posts <profile-url>" >&2; exit 2; }
      case "$2" in *"/company/"*) hp=/linkedin/company-posts; hk=company ;; *) hp=/linkedin/profile-posts; hk=profile ;; esac
      maxp="$(_pages)" || exit $?
      pd="$(mktemp -d)"; trap 'rm -rf "$pd"' EXIT
      tok=""; n=0; rc=0; got=0
      while [ "$n" -lt "$maxp" ] && [ "$got" -lt "$lim" ]; do
        if [ -n "$tok" ]; then _hv "$hp" "$hk=$2" "page=$((n + 1))" "paginationToken=$tok" >"$pd/$n.json"; rc=$?
        else _hv "$hp" "$hk=$2" >"$pd/$n.json"; rc=$?; fi
        [ $rc = 0 ] || { rm -f "$pd/$n.json"; break; }
        c="$(jq '.elements // [] | length' "$pd/$n.json")"; got=$((got + c))
        tok="$(jq -r '.pagination.paginationToken // empty' "$pd/$n.json")"
        n=$((n + 1)); { [ "$c" -gt 0 ] && [ -n "$tok" ]; } || break
      done
      if [ "$n" -gt 0 ]; then
        jq -rs '"reach: served by harvestapi, \(length) page(s), $\([.[].cost // 0] | add * 1000 | round / 1000) total"' "$pd"/*.json >&2
        jq -cs --argjson n "$lim" '[.[].elements // [] | .[]] | .[:$n][]' "$pd"/*.json
        exit 0
      fi
      [ $rc = 5 ] && exit 1
      echo "reach: falling back to Apify (harvestapi~linkedin-profile-posts)" >&2
      input="$(jq -n --arg u "$2" --argjson n "$lim" \
        '{targetUrls:[$u], maxPosts:$n, scrapeReactions:false, scrapeComments:false}')"
      _apify_items "harvestapi~linkedin-profile-posts" "$input" | jq -c '.[]'
    else
      case "$1" in http*) ;; *) echo "reach: pass a full profile/company URL, or 'posts <url>'" >&2; exit 2 ;; esac
      # main=true is the short profile ($0.004, "linkedinProfileShort"); the full
      # profile is a pricier tier. Output is the bare record, like the Actor's.
      case "$1" in *"/company/"*) out="$(_hv /linkedin/company "query=$1")" ;; *) out="$(_hv /linkedin/profile "query=$1" main=true)" ;; esac
      rc=$?
      if [ $rc = 0 ]; then echo "reach: served by harvestapi" >&2; printf '%s' "$out" | jq -c '.element'; exit 0; fi
      [ $rc = 5 ] && exit 1
      echo "reach: falling back to Apify" >&2
      case "$1" in
        *"/company/"*) input="$(jq -n --arg u "$1" '{companies:[$u]}')"
                       _apify_items "harvestapi~linkedin-company" "$input" | jq -c '.[]' ;;
        http*)         input="$(jq -n --arg u "$1" '{urls:[$u]}')"
                       _apify_items "harvestapi~linkedin-profile-scraper" "$input" | jq -c '.[]' ;;
        *)             echo "reach: pass a full profile/company URL, or 'posts <url>'" >&2; exit 2 ;;
      esac
    fi ;;

  facebook|fb) # reach facebook <query>   (routes to agent-reach)
    [ $# -ge 1 ] || { echo "usage: reach facebook <query>" >&2; exit 2; }
    b="$(_ar_backend facebook)"; [ "$b" = none ] && _need_social facebook "agent-reach install --channels facebook"
    opencli facebook search "$*" -f yaml ;;

  tiktok|tt) # reach tiktok <user|url> [limit]   (ScrapeCreators, 1 credit per 10 videos, no cookies)
    [ $# -ge 1 ] || { echo "usage: reach tiktok <user|url> [limit]" >&2; exit 2; }
    handle="${1#*tiktok.com/}"; handle="${handle#@}"; handle="${handle%%[/?]*}"
    lim="${2:-10}"; [[ "$lim" =~ ^[0-9]+$ ]] && [ "$lim" -ge 1 ] && [ "$lim" -le 50 ] || { echo "reach: limit must be 1..50" >&2; exit 2; }
    maxp="$(_pages)" || exit $?; want=$(( (lim + 9) / 10 )); [ "$want" -gt "$maxp" ] && want="$maxp"
    pd="$(mktemp -d)"; trap 'rm -rf "$pd"' EXIT
    cur=""; n=0
    while [ "$n" -lt "$want" ]; do
      if [ -n "$cur" ]; then _sc /v3/tiktok/profile/videos "handle=$handle" "max_cursor=$cur" trim=true >"$pd/$n.json" || { rm -f "$pd/$n.json"; break; }
      else _sc /v3/tiktok/profile/videos "handle=$handle" trim=true >"$pd/$n.json" || { rm -f "$pd/$n.json"; break; }; fi
      cur="$(jq -r 'if .has_more == true or .has_more == 1 then .max_cursor // empty else empty end' "$pd/$n.json")"
      n=$((n + 1)); [ -n "$cur" ] || break
    done
    [ "$n" -gt 0 ] || exit 1   # no fallback wired: Bright Data's TikTok dataset is async and unverified
    _sc_total "$n"
    jq -rs --arg h "$handle" --argjson n "$lim" '
      ((.[0].aweme_list[0].author // {}) | "## @\(.unique_id // $h) | \(.nickname // "") | followers:\(.follower_count // "?") videos:\(.aweme_count // "?")"),
      ([.[].aweme_list // [] | .[]] | .[:$n][] | "- video\(if .is_top == 1 or .is_top == true then " (pinned)" else "" end) | \((.create_time // 0) | todate) | plays:\(.statistics.play_count // 0) likes:\(.statistics.digg_count // 0) comments:\(.statistics.comment_count // 0) shares:\(.statistics.share_count // 0)\n  https://www.tiktok.com/@\($h)/video/\(.aweme_id)\n  \((.desc // "") | gsub("\\s+";" ") | .[0:200])")' "$pd"/*.json ;;

  facebook-page|fb-page) # reach facebook-page <page-url|name> [limit]   (ScrapeCreators, 1 credit per ~3 posts, no cookies)
    [ $# -ge 1 ] || { echo "usage: reach facebook-page <page-url|name> [limit]" >&2; exit 2; }
    case "$1" in http*) url="$1";; *) url="https://www.facebook.com/$1";; esac
    lim="${2:-6}"; [[ "$lim" =~ ^[0-9]+$ ]] && [ "$lim" -ge 1 ] && [ "$lim" -le 15 ] || { echo "reach: limit must be 1..15" >&2; exit 2; }
    maxp="$(_pages)" || exit $?; want=$(( (lim + 2) / 3 )); [ "$want" -gt "$maxp" ] && want="$maxp"
    pd="$(mktemp -d)"; trap 'rm -rf "$pd"' EXIT
    cur=""; n=0
    while [ "$n" -lt "$want" ]; do
      if [ -n "$cur" ]; then _sc /v1/facebook/profile/posts "url=$url" "cursor=$cur" >"$pd/$n.json" || { rm -f "$pd/$n.json"; break; }
      else _sc /v1/facebook/profile/posts "url=$url" >"$pd/$n.json" || { rm -f "$pd/$n.json"; break; }; fi
      cur="$(jq -r '.cursor // empty' "$pd/$n.json")"
      n=$((n + 1)); [ -n "$cur" ] || break
    done
    [ "$n" -gt 0 ] || exit 1
    _sc_total "$n"
    # topComments are third-party people: deliberately not printed.
    jq -rs --argjson n "$lim" '[.[].posts // [] | .[]] | .[:$n][] | "- \(if .videoDetails then "video" else "post" end) | \(if .publishTime then (.publishTime | todate) else "" end) | reactions:\(.reactionCount // 0) comments:\(.commentCount // 0) shares:\(.share_count // 0)\(if .videoViewCount then " views:\(.videoViewCount)" else "" end)\n  \(.url // .permalink // "")\n  \((.text // "") | gsub("\\s+";" ") | .[0:200])"' "$pd"/*.json ;;

  reviews) # reach reviews <google-maps-place-url> [days]   (Bright Data dataset, async, 1 credit per review)
    # Google Maps reviews are the one thing here no other vendor of ours returns.
    # Bright Data bills per delivered record (errors included): 5,000 free credits a
    # month, then $1.50/1k. REACH_BD_MAX caps records (default 20, max 200).
    [ $# -ge 1 ] || { echo "usage: reach reviews <google-maps-place-url> [days]   |   reach reviews --snapshot <id>" >&2; exit 2; }
    [ -n "${BRIGHTDATA_API_KEY:-}" ] || { echo "reach: BRIGHTDATA_API_KEY not set in $KEYS" >&2; exit 3; }
    bd="https://api.brightdata.com/datasets/v3"; ah="Authorization: Bearer $BRIGHTDATA_API_KEY"
    _bd_print() { jq -r 'if type=="array" then . else [.] end | .[] | if .error then "- (error record, billed) \(.error_code // "") \(.error)" else "- \(.review_rating // "?")★ | \(.review_date // "") | \(.reviewer_name // "")\(if .local_guide then " (local guide)" else "" end)\n  \((.review // "") | gsub("\\s+";" ") | .[0:300])\(if .response_of_owner then "\n  owner: \(.response_of_owner | gsub("\\s+";" ") | .[0:160])" else "" end)" end'; }
    if [ "$1" = --snapshot ]; then
      [ $# -eq 2 ] || { echo "usage: reach reviews --snapshot <id>" >&2; exit 2; }
      curl -sS --max-time 60 -H "$ah" "$bd/snapshot/$2?format=json" | _bd_print; exit 0
    fi
    case "$1" in
      https://www.google.*/maps/*|https://maps.google.*|https://maps.app.goo.gl/*|https://goo.gl/maps/*) url="$1" ;;
      *) echo "reach: pass a Google Maps place URL (open the place on maps.google.com and copy the address bar)" >&2; exit 2 ;;
    esac
    days="${2:-}"; max="${REACH_BD_MAX:-20}"
    [[ "$max" =~ ^[0-9]+$ ]] && [ "$max" -ge 1 ] && [ "$max" -le 200 ] || { echo "reach: REACH_BD_MAX must be 1..200" >&2; exit 2; }
    input="$(jq -n --arg u "$url" --arg d "$days" '{input:[{url:$u} + (if $d != "" then {days_limit:($d|tonumber)} else {} end)]}')"
    tr="$(curl -sS --max-time 30 -X POST -H "$ah" -H "Content-Type: application/json" \
      "$bd/trigger?dataset_id=gd_luzfs1dn2oa0teb81&include_errors=true&limit_multiple_results=$max" -d "$input" 2>&1)"
    sid="$(printf '%s' "$tr" | jq -r '.snapshot_id // empty' 2>/dev/null)"
    if [ -z "$sid" ]; then
      case "$tr" in
        *"not active"*) echo "reach: brightdata: account not active yet (activate it at brightdata.com/cp); nothing was billed" >&2 ;;
        *"Invalid credentials"*|*"Credentials are missing"*) echo "reach: brightdata: key rejected (401)" >&2 ;;
        *) echo "reach: brightdata: $(printf '%s' "$tr" | head -c 200)" >&2 ;;
      esac
      exit 1
    fi
    echo "reach: brightdata snapshot $sid (max $max records, billed per record)" >&2
    # 25 HTTP 429s in 5 minutes blacklist the IP on every Bright Data API, so poll slowly.
    waited=0; wmax="${REACH_BD_WAIT:-600}"
    while [ "$waited" -lt "$wmax" ]; do
      st="$(curl -sS --max-time 20 -H "$ah" "$bd/progress/$sid" | jq -r '.status // "?"' 2>/dev/null)"
      case "$st" in
        ready) out="$(curl -sS --max-time 60 -H "$ah" "$bd/snapshot/$sid?format=json")"
               echo "reach: served by brightdata, $(printf '%s' "$out" | jq 'if type=="array" then length else 1 end') record(s) billed" >&2
               printf '%s' "$out" | _bd_print; exit 0 ;;
        failed|canceled) echo "reach: brightdata snapshot $st" >&2; exit 1 ;;
      esac
      sleep 10; waited=$((waited + 10))
    done
    # Not cancelled on purpose: the collection is paid for, so keep the result.
    echo "reach: still collecting after ${wmax}s; fetch later with: reach reviews --snapshot $sid" >&2
    exit 4 ;;

  crawl) # reach crawl {map <domain>|site <url>} [flags]   (Firecrawl, USES CREDITS)
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      map)  firecrawl map "$@" ;;
      site) firecrawl crawl "$@" ;;
      *) echo "usage: reach crawl {map <domain>|site <url>} [flags]   (uses Firecrawl credits; free tier ~1000/mo)" >&2; exit 2 ;;
    esac ;;

  setup) # reach setup   (install the headless Chromium for the local web tier, matched to the pinned Playwright)
    command -v uv >/dev/null || { echo "reach: install uv first: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2; exit 2; }
    r="$(dirname "$(readlink -f "$0")")/reach-render.py"
    "$r" check 2>/dev/null && exit 0
    "$r" install && "$r" check ;;

  doctor) # reach doctor   (what works right now)
    ok(){ printf '  \033[32m✓\033[0m %-14s %s\n' "$1" "$2"; }
    no(){ printf '  \033[31m✗\033[0m %-14s %s\n' "$1" "$2"; }
    echo "reach doctor | server-less internet fetch"
    if command -v curl >/dev/null; then ok curl "any HTTP"; else no curl "missing"; fi
    if [ -n "${JINA_API_KEY:-}" ]; then jina_key="set"; else jina_key="none"; fi
    jc="$(curl -s --max-time 12 -o /dev/null -w '%{http_code}' "https://r.jina.ai/https://example.com" 2>/dev/null)"
    if [ "$jc" = 200 ]; then ok "web (jina)" "reach web <url>  [keyless ok]"; else no "web (jina)" "keyless HTTP ${jc:-timeout}"; fi
    if [ -n "${JINA_API_KEY:-}" ]; then
      jc="$(curl -s --max-time 12 -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $JINA_API_KEY" "https://r.jina.ai/https://example.com" 2>/dev/null)"
      case "$jc" in 200) ok "jina key" "has balance" ;; 402) no "jina key" "out of credits (402), top up at jina.ai" ;; *) no "jina key" "HTTP ${jc:-timeout}" ;; esac
    fi
    if ! command -v uv >/dev/null; then no "web (chromium)" "needs uv, then: reach setup"
    elif msg="$(timeout 60 "$(dirname "$(readlink -f "$0")")/reach-render.py" check 2>&1)"; then ok "web (chromium)" "local headless fallback (${msg#ok: })"
    else no "web (chromium)" "${msg##*$'\n'}, run: reach setup"; fi
    ok "repo-wiki" "reach repo-wiki <org/repo>  (DeepWiki via jina)"
    # Probe, don't just check the key exists: an out-of-credit key looked green here
    # while every search silently fell through to SearXNG. Costs one 1-result search.
    if [ -n "${EXA_API_KEY:-}" ]; then
      ex="$(curl -s --max-time 15 -X POST https://api.exa.ai/search -H "x-api-key: $EXA_API_KEY" \
        -H "Content-Type: application/json" -d '{"query":"example","numResults":1}' 2>/dev/null)"
      if printf '%s' "$ex" | jq -e '.results' >/dev/null 2>&1; then ok "search (exa)" "key works"
      else no "search (exa)" "$(printf '%s' "$ex" | jq -r '.error // .message // "no response"' 2>/dev/null | cut -c1-70)"; fi
    else no "search (exa)" "set EXA_API_KEY in $KEYS"; fi
    sx_ok=""; sxs="${SEARXNG_URL:-}"; for sx in ${sxs//,/ }; do curl -s -o /dev/null --max-time 3 "$sx/" && { sx_ok="$sx"; break; }; done
    if [ -n "$sx_ok" ]; then ok "search (searxng)" "$sx_ok"; else no "search (searxng)" "optional: set SEARXNG_URL in $KEYS"; fi
    if [ -n "${PERPLEXITY_API_KEY:-}" ]; then ok psearch "reach psearch <query>  (Perplexity)"; else no psearch "optional: set PERPLEXITY_API_KEY in $KEYS"; fi
    if command -v yt-dlp >/dev/null; then ok yt "reach yt <url>  ($(yt-dlp --version 2>/dev/null))"; else no yt "pipx install yt-dlp"; fi
    if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then ok gh "reach repo <org/repo>  (authed)"; else no gh "gh auth login"; fi
    ok rss "reach rss <feed>"
    if [ -n "${FIRECRAWL_API_KEY:-}" ]; then
      fcc="$(curl -s --max-time 12 -H "Authorization: Bearer $FIRECRAWL_API_KEY" https://api.firecrawl.dev/v2/team/credit-usage | jq -r '.data.remainingCredits // empty' 2>/dev/null)"
      if [ -n "$fcc" ] && [ "$fcc" -gt 0 ] 2>/dev/null; then ok firecrawl "web fallback, $fcc credits left"; else no firecrawl "${fcc:-?} credits left, top up at firecrawl.dev"; fi
    else no firecrawl "optional: set FIRECRAWL_API_KEY in $KEYS"; fi
    if command -v firecrawl >/dev/null; then ok "crawl" "reach crawl map|site  ($(firecrawl --version 2>/dev/null))"; else no "crawl" "needs the CLI: npm i -g firecrawl-cli"; fi
    if command -v pandoc >/dev/null; then ok pandoc "html->md"; else no pandoc "optional (web uses trafilatura via uv)"; fi
    # Apify refuses every run once the monthly cap is hit or an invoice is unpaid, while
    # the token itself stays valid. /users/me/limits is free to call.
    apify_bad=""
    if [ -n "${APIFY_TOKEN:-}" ]; then
      al="$(curl -s --max-time 12 -H "Authorization: Bearer $APIFY_TOKEN" https://api.apify.com/v2/users/me/limits 2>/dev/null)"
      apify_bad="$(printf '%s' "$al" | jq -r 'if .data then (if .data.current.monthlyUsageUsd >= .data.limits.maxMonthlyUsageUsd then "over monthly cap: $\(.data.current.monthlyUsageUsd|.*100|floor/100) of $\(.data.limits.maxMonthlyUsageUsd) (pay/upgrade at console.apify.com)" else empty end) else "token rejected" end' 2>/dev/null)"
      # The cap can be fine while runs are still refused: on 2026-10-22 every run got
      # 403 "Too many outstanding invoices" and the account had dropped to FREE, where
      # some Store actors also bill up to 100x per item. /users/me is free to call too.
      if [ -z "$apify_bad" ]; then
        me="$(curl -s --max-time 12 -H "Authorization: Bearer $APIFY_TOKEN" https://api.apify.com/v2/users/me 2>/dev/null)"
        apify_bad="$(printf '%s' "$me" | jq -r 'if .data and (.data.isPaying != true or .data.plan.tier == "FREE") then "on the FREE plan (unpaid invoice? paid actors refuse or bill up to 100x; console.apify.com/billing)" else empty end' 2>/dev/null)"
      fi
      if [ -n "$apify_bad" ]; then no apify "$apify_bad"; else ok apify "paid plan, within monthly cap"; fi
    fi
    # Social-data vendors: balance reads are free calls, so these show live numbers.
    hv_ok=""; sc_ok=""
    if [ -n "${HARVESTAPI_KEY:-}" ]; then
      hb="$(curl -s --max-time 12 -H "X-API-Key: $HARVESTAPI_KEY" https://api.harvestapi.io/users/my-api-user | jq -r '.usage.balance // empty' 2>/dev/null)"
      if [ -n "$hb" ] && awk "BEGIN{exit !($hb >= 0.01)}"; then ok harvestapi "\$$hb left (LinkedIn, \$0.004 per lookup or ~100-post page)"; hv_ok=1
      elif [ -n "$hb" ]; then no harvestapi "\$$hb left, top up at harvestapi.io"
      else no harvestapi "key rejected or API unreachable"; fi
    else no harvestapi "optional: set HARVESTAPI_KEY in $KEYS (LinkedIn, cheaper than Apify)"; fi
    if [ -n "${SCRAPECREATORS_API_KEY:-}" ]; then
      sb="$(curl -s --max-time 12 -H "x-api-key: $SCRAPECREATORS_API_KEY" https://api.scrapecreators.com/v1/credit-balance | jq -r '.creditCount // empty' 2>/dev/null)"
      if [ -n "$sb" ] && [ "$sb" -ge 10 ] 2>/dev/null; then ok scrapecreators "$sb credits left (IG/TikTok/FB, 1 credit per page)"; sc_ok=1
      elif [ -n "$sb" ]; then no scrapecreators "$sb credits left, top up at scrapecreators.com"
      else no scrapecreators "key rejected or API unreachable"; fi
    else no scrapecreators "optional: set SCRAPECREATORS_API_KEY in $KEYS (IG/TikTok/FB)"; fi
    if [ -n "${BRIGHTDATA_API_KEY:-}" ]; then
      # No balance read with a scraper key (403). A trigger with a deliberately invalid
      # input is rejected before anything runs, so it is free and still says whether
      # the key works and the account is active.
      bp="$(curl -s --max-time 15 -X POST -H "Authorization: Bearer $BRIGHTDATA_API_KEY" -H "Content-Type: application/json" \
        "https://api.brightdata.com/datasets/v3/trigger?dataset_id=gd_luzfs1dn2oa0teb81" -d '{"input":[{}]}' 2>/dev/null)"
      case "$bp" in
        *validation_error*) ok brightdata "key works, account active (balance not readable with this key)" ;;
        *"not active"*) no brightdata "account not active yet: activate at brightdata.com/cp" ;;
        *) no brightdata "$(printf '%s' "$bp" | head -c 70)" ;;
      esac
    else no brightdata "optional: set BRIGHTDATA_API_KEY in $KEYS (reach reviews)"; fi
    if [ -n "$sc_ok" ]; then ok instagram "reach instagram <user>  (ScrapeCreators, Apify fallback)"
    elif [ -n "${APIFY_TOKEN:-}" ] && [ -z "$apify_bad" ]; then ok instagram "reach instagram <user>  (Apify only)"
    else no instagram "needs SCRAPECREATORS_API_KEY or a working APIFY_TOKEN"; fi
    if [ -n "$sc_ok" ]; then ok tiktok "reach tiktok <user>  (ScrapeCreators)"; ok facebook-page "reach facebook-page <page>  (ScrapeCreators)"
    else no tiktok "needs SCRAPECREATORS_API_KEY"; no facebook-page "needs SCRAPECREATORS_API_KEY"; fi
    if [ -n "${APIFY_TOKEN:-}" ] && [ -n "$apify_bad" ]; then
      for r in reddit x-public x-followers; do no "$r" "Apify refuses runs (see the apify line)"; done
    elif [ -n "${APIFY_TOKEN:-}" ]; then
      ok reddit "reach reddit <sub>  (Apify, no app/cookies)"
      ok x-public "reach x-public <query>  (Apify Actor, public data)"
      ok x-followers "reach x-followers <handle>  (Apify Actor, public data)"
    else
      no reddit "set APIFY_TOKEN in $KEYS"
      no x-public "set APIFY_TOKEN in $KEYS"
      no x-followers "set APIFY_TOKEN in $KEYS"
    fi
    if command -v uv >/dev/null; then ok doc "reach doc <file>  (anydoc, local, no key)"; else no doc "install uv for reach doc"; fi
    ws_ok=""; wss="${WHISPER_SERVER_URL:-}"; for ws in ${wss//,/ }; do curl -s -o /dev/null --max-time 3 "${ws%/}/" && { ws_ok="${ws%/}"; break; }; done
    if [ -n "$ws_ok" ]; then ok transcribe "reach transcribe <audio>  (whisper.cpp at $ws_ok, Groq fallback)"
    elif [ -n "${GROQ_API_KEY:-}" ]; then ok transcribe "reach transcribe <audio>  (Groq Whisper)"
    else no transcribe "set WHISPER_SERVER_URL or GROQ_API_KEY in $KEYS"; fi
    if [ -n "$hv_ok" ]; then ok linkedin "reach linkedin <url>  (HarvestAPI, Apify fallback)"
    elif [ -n "${APIFY_TOKEN:-}" ] && [ -z "$apify_bad" ]; then ok linkedin "reach linkedin <url>  (Apify only)"
    else no linkedin "needs HARVESTAPI_KEY or a working APIFY_TOKEN"; fi
    for p in twitter facebook; do
      b="$(_ar_backend "$p")"
      if [ "$b" != none ]; then ok "$p" "reach $p  (via agent-reach: $b)"
      else printf '  \033[33m~\033[0m %-14s %s\n' "$p" "reach $p  (routes to agent-reach; needs burner setup)"; fi
    done ;;

  help|--help|-h|*)
    cat <<'EOF'
reach | server-less internet fetch (direct APIs + CLIs, no MCP, no RAM)

  reach web <url>            clean markdown of any page (JS-rendered), via Jina Reader
  reach repo-wiki <org/repo> DeepWiki repo explainer (via Jina)
  reach search <query>       web search: Exa -> SearXNG (SEARXNG_URL) -> Jina
  reach psearch <query>      Perplexity Search API, cited results (needs PERPLEXITY_API_KEY)
  reach yt <url>             YouTube metadata + auto transcript (yt-dlp)
  reach rss <feed-url>       latest items from an RSS/Atom feed
  reach repo <org/repo>      GitHub metadata + README (gh)
  reach instagram <user> [n] Instagram posts (ScrapeCreators, Apify fallback)
  reach tiktok <user> [n]    TikTok videos (ScrapeCreators)
  reach facebook-page <page> [n] Facebook page posts (ScrapeCreators)
  reach reviews <maps-url> [days] Google Maps reviews (Bright Data, async)
  reach reddit <query>       Reddit search (Apify, no app); scope with: reach reddit r/<sub> <query>
  reach x-public <query>     Public X search   (Apify Actor, no cookies)
  reach x-public user <handle> Public X timeline (Apify Actor, no cookies)
  reach x-followers <handle> Public follower relations (Apify Actor)
  reach doc <file>           Word/PPT/Excel/PDF/EPUB/ODF -> markdown (local, keyless)
  reach transcribe <audio>   audio/podcast -> text (whisper.cpp at WHISPER_SERVER_URL, Groq fallback)
  reach x <query>            X/Twitter    (routes to agent-reach, needs burner setup)
  reach linkedin <url>       LinkedIn profile/company (HarvestAPI, Apify fallback)
  reach linkedin posts <url> LinkedIn post history (HarvestAPI, Apify fallback)
  reach facebook <query>     Facebook     (routes to agent-reach, needs burner setup)
  reach crawl map <domain>   discover URLs (Firecrawl, uses credits)
  reach crawl site <url>     managed JS crawl (Firecrawl, uses credits)
  reach doctor               what works right now, with live vendor balances

reach is the single front door: each command auto-picks its backend; the cookie-gated
platforms (x for logged-in depth, facebook) route to agent-reach under the hood.
Keys: ~/.reach/keys.env  ->  EXA_API_KEY, JINA_API_KEY, FIRECRAWL_API_KEY, APIFY_TOKEN
      (Reddit+X Actors, IG+LinkedIn fallback), HARVESTAPI_KEY, SCRAPECREATORS_API_KEY,
      BRIGHTDATA_API_KEY, GROQ_API_KEY, PERPLEXITY_API_KEY
Paid social calls print their cost on stderr. REACH_PAGES=1..5 (default 1) bounds
billed pages per call; REACH_BD_MAX=1..200 (default 20) bounds Bright Data records.
Self-hosted (optional, comma-separate several): SEARXNG_URL, WHISPER_SERVER_URL
Set REACH_APIFY_LIMIT=1..200 to change the X Actor result cap. The default is 20.
EOF
    ;;
esac
